# ========================================================= #
# dvlyadmin-mini 生产环境配置档案（模板）
# 部署到服务器（宝塔/如意面板等非 Docker 方式）二选一：
#   方式 A（推荐）：cp .env.prod .env 然后修改密码等敏感项
#                  —— .env 已被 .gitignore 忽略，真实密钥只存在服务器上
#   方式 B：在面板的 Python 项目环境变量/启动命令里设置 DVLYADMIN_ENV=prod
#                  —— 适合同机多套环境按档案切换（还可扩展 .env.staging 等）
# 注意：
#   - 本档案含占位密码，可提交 git；真实密钥请只填进服务器上的 .env
#   - 整目录拷贝部署时不要用本地文件覆盖服务器上已配置好的 .env
# ========================================================= #

# ---------- 应用配置 ----------
# 生产必须关闭调试模式
DVLYADMIN_DEBUG=False
# Django SECRET_KEY（强烈建议替换为随机值，生成命令：
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"）
#DJANGO_SECRET_KEY=
# 演示模式（True 时全站只读不可增删改）
DVLYADMIN_IS_DEMO=False
# 对外访问域名（图片 URL 前缀 / 回调等，结尾不带斜杠）
DVLYADMIN_DOMAIN_HOST=https://www.lybbn.cn

# ---------- 数据库（按面板实际开通情况二选一） ----------
# MySQL：
DVLYADMIN_DATABASE_TYPE=MYSQL
DVLYADMIN_DATABASE_HOST=127.0.0.1
DVLYADMIN_DATABASE_PORT=3306
DVLYADMIN_DATABASE_USER=dvlyadmin_mini
DVLYADMIN_DATABASE_PASSWORD=dvlyadmin_mini@2026@123!
DVLYADMIN_DATABASE_NAME=dvlyadmin_mini
# SQLite（免装数据库）：
#DVLYADMIN_DATABASE_TYPE=SQLITE3

# ---------- Redis（可选） ----------
# 单机部署可继续用内存缓存（true），也可装 Redis 改为 false
DVLYADMIN_CACHE_LOCMEM=false
DVLYADMIN_REDIS_HOST=127.0.0.1
DVLYADMIN_REDIS_PORT=6379
DVLYADMIN_REDIS_PASSWORD=

# ---------- 邮件 SMTP（注册/绑定邮箱验证码依赖） ----------
DVLYADMIN_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#DVLYADMIN_EMAIL_HOST=smtp.163.com
#DVLYADMIN_EMAIL_PORT=25
#DVLYADMIN_EMAIL_HOST_USER=
#DVLYADMIN_EMAIL_HOST_PASSWORD=
#DVLYADMIN_EMAIL_USE_TLS=False
#DVLYADMIN_DEFAULT_FROM_EMAIL=
