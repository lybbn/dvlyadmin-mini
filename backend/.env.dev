# ========================================================= #
# dvlyadmin-mini 开发环境配置档案
# 加载规则（config.py 启动时自动执行，命中即停）：
#   backend/.env > .env.{DVLYADMIN_ENV} > .env.dev（本文件）
# 本地开发无需任何操作：无 .env 且未设 DVLYADMIN_ENV 时自动加载本档案。
# 本档案只放安全的开发值，可提交 git；真实密钥一律不要写在这里。
# ========================================================= #

# ---------- 应用配置 ----------
DVLYADMIN_DEBUG=True
DVLYADMIN_IS_DEMO=False
# 本地开发地址
DVLYADMIN_DOMAIN_HOST=http://127.0.0.1:8000

# ---------- 数据库 ----------
# 本地开发用 SQLite（backend/db.sqlite3，零配置）
DVLYADMIN_DATABASE_TYPE=SQLITE3
# 本地如需连 MySQL，取消下面注释并修改
#DVLYADMIN_DATABASE_TYPE=MYSQL
#DVLYADMIN_DATABASE_HOST=127.0.0.1
#DVLYADMIN_DATABASE_PORT=3306
#DVLYADMIN_DATABASE_USER=root
#DVLYADMIN_DATABASE_PASSWORD=root
#DVLYADMIN_DATABASE_NAME=dvlyadmin_mini

# ---------- 缓存 ----------
# 本地无 Redis，用内存缓存
DVLYADMIN_CACHE_LOCMEM=true

# ---------- 邮件 ----------
# 开发环境验证码等邮件直接输出到控制台，不真实发信（避免误发/耗配额）
# 如需本地联调真实收信，注释掉下一行即可回落到 config.py 的 SMTP 默认配置
DVLYADMIN_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
